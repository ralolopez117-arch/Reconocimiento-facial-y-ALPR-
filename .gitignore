__pycache__/
*.py[cod]

# Base de datos local (detecciones, placas, rostros)
alpr_data.db

# Fotos de rostros registrados
static/faces/

# Clave con la que Flask firma las cookies de sesión.
# Es un secreto por instalación y nunca debe compartirse.
.flask_secret

# Configuración local: incluye las URLs de las cámaras y las credenciales
# ONVIF. Es propia de cada instalación y no debe versionarse.
# La plantilla con la estructura está en config.example.json.
config.json

# Entornos virtuales
venv/
.venv/
env/

# Modelos descargados bajo demanda por ultralytics (no son fuente del proyecto)
yolov8n-seg.pt

# Grabaciones del NVR y su indice. Son gigabytes de video y datos locales.
recordings/

# Configuracion del NVR: incluye la clave de acceso compartida y las rutas
# de almacenamiento propias de cada instalacion.
nvr_config.json

# Planos que suba el administrador para el mapa: son de cada instalación
static/maps/
